DimOrganization {

    // ============================
    // Parent-Child Hierarchy Core
    // ============================

    column HierarchyPath {
        dataType: string;
        expression: "PATH(DimOrganization[OrganizationKey], DimOrganization[ParentOrganizationKey])";
        formatString: "Text";
        isHidden: true;
    }

    column HierarchyLevel {
        dataType: int64;
        expression: "PATHLENGTH(DimOrganization[HierarchyPath])";
        formatString: "0";
        isHidden: true;
    }

    column TopOrganizationKey {
        dataType: int64;
        expression: "PATHITEM(DimOrganization[HierarchyPath], 1, INTEGER)";
        formatString: "0";
        isHidden: true;
    }

    column TopOrganizationName {
        dataType: string;
        expression: "LOOKUPVALUE(DimOrganization[OrganizationName], DimOrganization[OrganizationKey], DimOrganization[TopOrganizationKey])";
        formatString: "Text";
        isHidden: false;
        sortByColumn: TopOrganizationKey;
    }

    column ParentOrganizationName {
        dataType: string;
        expression: "LOOKUPVALUE(DimOrganization[OrganizationName], DimOrganization[OrganizationKey], DimOrganization[ParentOrganizationKey])";
        formatString: "Text";
        isHidden: false;
    }

    // ============================
    // Dynamic Level Columns
    // ============================

    // Level 1
    column Level1Key {
        dataType: int64;
        expression: "PATHITEM(DimOrganization[HierarchyPath], 1, INTEGER)";
        formatString: "0";
        isHidden: true;
    }

    column Level1Name {
        dataType: string;
        expression: "LOOKUPVALUE(DimOrganization[OrganizationName], DimOrganization[OrganizationKey], DimOrganization[Level1Key])";
        formatString: "Text";
        isHidden: false;
        sortByColumn: Level1Key;
    }

    // Level 2
    column Level2Key {
        dataType: int64;
        expression: "PATHITEM(DimOrganization[HierarchyPath], 2, INTEGER)";
        formatString: "0";
        isHidden: true;
    }

    column Level2Name {
        dataType: string;
        expression: "LOOKUPVALUE(DimOrganization[OrganizationName], DimOrganization[OrganizationKey], DimOrganization[Level2Key])";
        formatString: "Text";
        isHidden: false;
        sortByColumn: Level2Key;
    }

    // ============================
    // Display Folders
    // ============================

    annotation DisplayFolders {
        HierarchyPath: "Hierarchy/Internal";
        HierarchyLevel: "Hierarchy/Internal";
        TopOrganizationKey: "Hierarchy/Internal";
        TopOrganizationName: "Hierarchy";
        ParentOrganizationName: "Hierarchy";
        Level1Key: "Hierarchy/Internal";
        Level1Name: "Hierarchy/Levels";
        Level2Key: "Hierarchy/Internal";
        Level2Name: "Hierarchy/Levels";
    }
}
